{
  "package": {
    "productName": "Artefac Sim Client",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "vite --port 8080",
    "beforeBuildCommand": "vite build",
    "devPath": "http://127.0.0.1:8080",
    "distDir": "../dist"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "Artefac Simulation",
        "fullscreen": false,
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousRemoteDomainIpcAccess": [
        { "domain": "127.0.0.1:8080", "windows": ["main"], "enableTauriAPI": true }
      ]
    },
    "bundle": {
      "active": false,
      "identifier": "com.evolutek.artefac.simclient",
      "icon": []
    }
  }
}