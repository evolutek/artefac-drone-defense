# Copy this file to .env and adapt values for your environment
# Do not commit .env file (it's in .gitignore)

# =============================================================================
# Host OS Configuration
# =============================================================================
# ⚠️ REQUIRED: Set your operating system (used by ./start.sh script)
# Valid values: linux, macos, windows
HOST_OS=linux

# =============================================================================
# ROS2 Configuration (for simulation and ros2_core service)
# =============================================================================
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# =============================================================================
# Display Configuration (for Gazebo GUI)
# =============================================================================
# ⚠️ IMPORTANT: The ./start.sh script will automatically configure X11
# based on your HOST_OS setting above. Manual configuration is optional.

# Linux (Native X11)
DISPLAY=:0
XAUTHORITY=~/.docker.xauth

# macOS (requires XQuartz installed)
# DISPLAY=host.docker.internal:0
# XAUTHORITY=~/.docker.xauth

# Windows WSL2 (requires VcXsrv or X410)
# DISPLAY=<WINDOWS_HOST_IP>:0
# XAUTHORITY=~/.docker.xauth

# =============================================================================
# Backend Configuration
# =============================================================================
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./backend_data/app.db

# =============================================================================
# MQTT Broker Configuration
# =============================================================================
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883

# =============================================================================
# PX4 SITL Simulation Configuration
# =============================================================================
# Home position coordinates (Toulouse, France by default)
PX4_HOME_LAT=43.6047
PX4_HOME_LON=1.4442
PX4_HOME_ALT=0

# PX4 simulation model
PX4_GZ_MODEL=default
PX4_SIM_MODEL=gz_x500

# Headless mode (0=GUI enabled, 1=headless)
HEADLESS=0
