# Copy this file to .env and adapt values for your environment
# Do not commit .env file (it's in .gitignore)

# =============================================================================
# ROS2 Configuration (for simulation and ros2_core service)
# =============================================================================
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# =============================================================================
# Display Configuration (for Gazebo GUI)
# =============================================================================
# ⚠️ IMPORTANT: See DISPLAY_SETUP.md for detailed setup instructions per OS
# https://github.com/evolutek/artefac-drone-defense/blob/main/DISPLAY_SETUP.md

# Linux (Native X11)
DISPLAY=:0
XAUTHORITY=/tmp/.docker.xauth
# Run: xhost +local:docker

# macOS (requires XQuartz)
# DISPLAY=host.docker.internal:0
# XAUTHORITY=/tmp/.docker.xauth
# Install XQuartz and enable "Allow connections from network clients"

# Windows WSL2 (requires VcXsrv or X410)
# DISPLAY=<WINDOWS_HOST_IP>:0
# XAUTHORITY=/tmp/.docker.xauth
# Launch VcXsrv with "Disable access control" enabled

# =============================================================================
# Backend Configuration
# =============================================================================
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./backend_data/app.db

# =============================================================================
# MQTT Broker Configuration
# =============================================================================
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883

# =============================================================================
# PX4 SITL Simulation Configuration
# =============================================================================
# Home position coordinates (Toulouse, France by default)
PX4_HOME_LAT=43.6047
PX4_HOME_LON=1.4442
PX4_HOME_ALT=0

# PX4 simulation model
PX4_GZ_MODEL=default
PX4_SIM_MODEL=gz_x500

# Headless mode (0=GUI enabled, 1=headless)
HEADLESS=0
