#!/bin/sh
# PX4 startup script for GPS-free operation with vision position fusion
# This script is loaded by PX4 SITL at startup for indoor/GPS-denied scenarios

# ========================================
# GPS-Free Operation Parameters
# ========================================

# Allow arming without GPS
param set COM_ARM_WO_GPS 1

# Disable GPS fusion in EKF2
param set EKF2_GPS_CTRL 0

# Enable vision position fusion
# Bit 0: Horizontal position (1)
# Bit 1: Vertical position (2)
# Bit 2: Velocity (4)
# Bit 3: Yaw (8)
# Total: 15 = 0b1111 = enable all vision fusion
param set EKF2_EV_CTRL 15

# Use barometric pressure for height reference
# Vision will still be used for horizontal position and yaw
# 0: Barometric pressure (CHANGED from 3 to avoid GPS conflict)
# 1: GPS
# 2: Range sensor
# 3: Vision
param set EKF2_HGT_REF 0

# Vision position delay compensation (ms)
param set EKF2_EV_DELAY 0

# Vision position noise (m) - Increased for more tolerance
param set EKF2_EVP_NOISE 0.5

# Vision velocity noise (m/s) - Increased for more tolerance
param set EKF2_EVV_NOISE 0.5

# Vision yaw noise (rad)
param set EKF2_EVA_NOISE 0.1

# Disable pre-flight mode to allow arming without GPS
param set COM_PREARM_MODE 0

# RC loss action: 0 = disabled
param set NAV_RCL_ACT 0

# RC input mode: 1 = stick movement required
param set COM_RC_IN_MODE 1

# Low battery action: 1 = warning only
param set COM_LOW_BAT_ACT 1

# Geofence action: 0 = none
param set GF_ACTION 0

# Disable automatic disarm after landing
param set COM_DISARM_LAND -1

# Position failure thresholds (more lenient for vision)
param set COM_POS_FS_EPH 10.0
param set COM_VEL_FS_EVH 2.0

# ========================================
# MAVLink Configuration
# ========================================

# Enable broadcast for network connectivity
param set MAV_0_BROADCAST 1
param set MAV_1_BROADCAST 1

# Enable odometry message streaming for debugging
# This allows verification that PX4 is receiving vision data
param set MAV_ODOM_LP 1

echo "[CUSTOM GPS-FREE] PX4 configured for vision-based position estimation"
echo "[CUSTOM GPS-FREE] EKF2_GPS_CTRL=0, EKF2_EV_CTRL=15, EKF2_HGT_REF=0 (barometer)"
echo "[CUSTOM GPS-FREE] Vision used for horizontal position + yaw, barometer for altitude"
echo "[CUSTOM GPS-FREE] COM_ARM_WO_GPS=1, MAV_ODOM_LP=1, ready for indoor operation"
