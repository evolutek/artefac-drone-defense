# PX4 Parameters for simulation without GPS
# This configuration allows arming without GPS fix for indoor/simulation use

# Disable GPS requirement for arming
COM_ARM_WO_GPS 1

# Set estimator to not require GPS
EKF2_GPS_CTRL 0

# Allow arming in manual mode without GPS
NAV_RCL_ACT 0

# Reduce pre-arm safety checks for simulation
COM_PREARM_MODE 0

# Set RC loss failsafe to disabled (for automated control)
NAV_RCL_ACT 0

# Allow arming without RC check (for MAVROS control)
COM_RC_IN_MODE 1

# Set low battery failsafe to warning only
COM_LOW_BAT_ACT 1

# Flight mode configuration
# COM_FLTMODE1 through COM_FLTMODE6 can be set for different RC switch positions
# Mode values:
#   0 = Manual
#   1 = Altitude
#   2 = Position (requires GPS)
#   3 = Mission (requires GPS)
#   4 = Hold (loiter)
#   5 = Return
#   6 = Acro
#   7 = Offboard
#   8 = Stabilized
#   10 = Takeoff
#   11 = Land
#   12 = Follow Me

# Default to Stabilized mode (no GPS required)
COM_FLTMODE1 8

# Geofence disabled for indoor flight
GF_ACTION 0

# Disable automatic disarm on land
COM_DISARM_LAND -1

# Set home position from environment variables at runtime
# (PX4_HOME_LAT, PX4_HOME_LON are handled by SITL startup)
