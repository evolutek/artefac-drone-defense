# Dockerfile for PX4 SITL + Gazebo Harmonic Simulation
# Based on PX4 official development container

ARG UBUNTU_VERSION=jammy
FROM ubuntu:${UBUNTU_VERSION}

# Re-declare ARG after FROM (required for Docker multi-stage builds)
ARG PX4_VERSION=v1.16.0
ARG DEBIAN_FRONTEND=noninteractive

LABEL maintainer="Evolutek Team"
LABEL description="PX4 SITL with Gazebo Harmonic for drone simulation"
LABEL px4.version="${PX4_VERSION}"
LABEL gazebo.version="Harmonic"

# Install basic dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    lsb-release \
    sudo \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Add ROS2 Humble repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
    | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# Install ROS2 Humble base
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-ros-base \
    && rm -rf /var/lib/apt/lists/*

# Install PX4 development dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    astyle \
    bc \
    build-essential \
    ccache \
    cmake \
    cppcheck \
    file \
    g++ \
    gcc \
    gdb \
    lcov \
    make \
    ninja-build \
    python3 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    rsync \
    shellcheck \
    unzip \
    xsltproc \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Add Gazebo Harmonic repository
RUN wget https://packages.osrfoundation.org/gazebo.gpg -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
    | tee /etc/apt/sources.list.d/gazebo-stable.list > /dev/null

# Install Gazebo Harmonic and OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    gz-harmonic \
    libgz-sim8-dev \
    libopencv-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages for PX4
RUN pip3 install --no-cache-dir \
    argparse \
    cerberus \
    empy==3.3.4 \
    future \
    jinja2 \
    jsonschema \
    kconfiglib \
    numpy \
    packaging \
    pyros-genmsg \
    pyulog \
    pyyaml \
    requests \
    toml \
    wheel

# Install MAVLink tools
RUN pip3 install --no-cache-dir \
    pymavlink \
    mavproxy

# Clone PX4 Autopilot repository
WORKDIR /root
RUN git clone https://github.com/PX4/PX4-Autopilot.git \
    && cd PX4-Autopilot \
    && git checkout ${PX4_VERSION} \
    && git submodule update --init --recursive

# Copy custom x500 model with odometry plugin
COPY models/x500/model.sdf /tmp/x500_model_custom.sdf
# Copy custom configuration files BEFORE build
COPY config/px4_params_no_gps.params /root/config/px4_params_no_gps.params
COPY config/rcS_no_gps /root/config/rcS_no_gps
COPY models/ /root/PX4-Autopilot/Tools/simulation/gz/models/
COPY gazebo_worlds/ /root/PX4-Autopilot/Tools/simulation/gz/worlds/
RUN chmod +x /root/config/rcS_no_gps

# Inject GPS-enabled parameters into PX4 startup (before build)
WORKDIR /root/PX4-Autopilot
RUN mkdir -p ROMFS/px4fmu_common/init.d-posix 
COPY rc.autostart.sh ROMFS/px4fmu_common/init.d-posix/rc.autostart_ext
RUN chmod +x ROMFS/px4fmu_common/init.d-posix/rc.autostart_ext

# Build PX4 SITL without running simulation
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    make px4_sitl_default"

# Replace default x500 model with custom model that includes odometry publisher
RUN cp /tmp/x500_model_custom.sdf /root/PX4-Autopilot/Tools/simulation/gz/models/x500/model.sdf

# Set environment variables
ENV PX4_HOME_LAT=43.6047
ENV PX4_HOME_LON=1.4442
ENV PX4_HOME_ALT=0
ENV GZ_SIM_RESOURCE_PATH=/root/PX4-Autopilot/Tools/simulation/gz/models:/root/PX4-Autopilot/Tools/simulation/gz/worlds
ENV GZ_SIM_SYSTEM_PLUGIN_PATH=/root/PX4-Autopilot/build/px4_sitl_default/build_gz
ENV LD_LIBRARY_PATH=/root/PX4-Autopilot/build/px4_sitl_default/build_gz
ENV GAZEBO_WORLD=/root/PX4-Autopilot/Tools/simulation/gz/worlds/simple_city.worlds

# Create entrypoint script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Source ROS2\n\
source /opt/ros/humble/setup.bash\n\
\n\
# Setup X11 for GUI\n\
if [ ! -z "$DISPLAY" ]; then\n\
    echo "Display configured: $DISPLAY"\n\
fi\n\
\n\
# Execute command\n\
exec "$@"\n\
' > /root/entrypoint.sh && chmod +x /root/entrypoint.sh

ENTRYPOINT ["/root/entrypoint.sh"]
CMD ["bash"]
