<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
    <world name="harmonic_heightmap">
        <!-- Physics configuration -->
        <physics name="1ms" type="ignore">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <!-- Plugin for physics engine -->
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>
        <plugin
            filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
        </plugin>

        <!-- Atmosphere and lighting -->
        <atmosphere type="adiabatic"/>
        <scene>
            <ambient>0.8 0.8 0.8 1.0</ambient>
            <background>0.8 0.9 1.0 1.0</background>
            <shadows>true</shadows>
            <grid>false</grid>
        </scene>

        <!-- Sun (directional light) -->
        <light name="sun" type="directional">
            <pose>0 0 100 0 0 0</pose>
            <cast_shadows>true</cast_shadows>
            <intensity>1.0</intensity>
            <direction>-0.5 0.1 -0.9</direction>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
        </light>

        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <world_frame_orientation>ENU</world_frame_orientation>
            <latitude_deg>47.397971057728974</latitude_deg>
            <longitude_deg> 8.546163739800146</longitude_deg>
            <elevation>0</elevation>
        </spherical_coordinates>

        <model name="harmonic_terrain">
            <static>true</static>
            <pose>0 0 0 0 0 0</pose>
            <link name="terrain_link">
                <pose>0 0 0 0 0 0</pose>
                <visual name="terrain_visual">
                    <geometry>
                        <mesh>
                            <uri>file:///Users/dalm1/Desktop/reroll/Progra/drone-def/REROLL/artefac-drone-defense/simulation/gazebo_worlds/meshes/nb_park.dae</uri>
                        </mesh>
                    </geometry>
                    <cast_shadows>true</cast_shadows>
                </visual>
                <collision name="terrain_collision">
                    <geometry>
                        <mesh>
                            <uri>file:///Users/dalm1/Desktop/reroll/Progra/drone-def/REROLL/artefac-drone-defense/simulation/gazebo_worlds/meshes/nb_park.dae</uri>
                        </mesh>
                    </geometry>
                </collision>
            </link>
        </model>

    </world>
</sdf>
